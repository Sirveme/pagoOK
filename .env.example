# pagoOK Admin — variables de entorno

# Modo
ENV=development
DEBUG=true
PORT=4000

# BD pagoOK (Railway PostgreSQL)
# Copia esto desde tu servicio pagook-db en Railway > Variables > DATABASE_URL
DATABASE_URL=postgresql://usuario:password@host:puerto/basedatos

# Backend Gestix (para precios localizados en landing)
GESTIX_API_URL=http://localhost:8001
GESTIX_API_URL_PUBLIC=https://gestix.pro

# WhatsApp y contacto
WHATSAPP_NUMERO=51967317946
EMAIL_CONTACTO=info@perusistemas.pro

# Bootstrap admin: si la pones, esa será la password inicial del admin
# Si la dejas vacía, el script generará una aleatoria y la imprimirá
ADMIN_BOOTSTRAP_PASSWORD=

# =============================================================
# Multi-empresa (zWeb-04)
# =============================================================
# produccion (default) | desarrollo. En desarrollo el OTP se escribe en el log
# (DevEnviador) y la cookie de sesión no lleva Secure. NUNCA desarrollo en Railway.
PAGOOK_ENTORNO=produccion
# Clave del servidor para hashear códigos cortos (OTP, vinculación). Aleatoria,
# 32+ caracteres, solo en Railway. Generar: python -c "import secrets;print(secrets.token_urlsafe(32))"
PAGOOK_PEPPER=
# Base de los enlaces de invitación (https://pagook.pro/unirse/<token>)
PAGOOK_URL_PUBLICA=https://pagook.pro
# true mientras la app 1.5.x abra /perusistemas/ingresos sin sesión (se apaga en zStore-05)
LEGACY_PUBLICO_PERUSISTEMAS=true

# WhatsApp Cloud API (Meta), igual que Te Atiendo. Sin esto, en producción el
# ingreso al panel responde 503 otp_no_disponible.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# Plantilla de categoría AUTHENTICATION aprobada en Meta (cuerpo con {{1}} = código)
WA_OTP_PLANTILLA=
WA_OTP_IDIOMA=es
# 1 si la plantilla tiene el botón "Copiar código" (lo normal en AUTHENTICATION)
WA_OTP_BOTON=1
GRAPH_API_VERSION=v23.0

# API de RUC del ecosistema (apis.net.pe v2). La usa scripts/gestion_empresas.py
APIS_NET_PE_TOKEN=

# Slugs con pantalla pública de pagos en vivo (/{slug} y /api/v1/demo/{slug}),
# separados por coma. Cualquier otro slug responde 404.
SLUGS_DEMO=perusistemas

# Canal de correo bancario (zWeb-06). Secreto compartido con el Email Worker de
# Cloudflare (header X-Correo-Secreto). Vacío = el endpoint responde 503.
# Generar: python -c "import secrets;print(secrets.token_urlsafe(32))"
CORREO_ENTRANTE_SECRETO=
# Subdominio de las direcciones egresos+<código>@<dominio>
CORREO_DOMINIO=bancos.pagook.pro

# Revisor de Google Play: código de vinculación que no vence y sirve varias veces.
# Vacío = desactivado. Los celulares que lo usan caen en EMPRESA_REVISION_PLAY.
CODIGO_REVISION_PLAY=
EMPRESA_REVISION_PLAY=demo-revision
